<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="orange_robot">

  <!-- Simulation footprint parameters. Replace with measured robot dimensions later. -->
  <xacro:property name="base_length" value="1.00"/>
  <xacro:property name="base_width" value="0.70"/>
  <xacro:property name="wheel_separation" value="0.65"/>
  <xacro:property name="wheel_radius" value="0.10"/>
  <xacro:property name="caster_x" value="0.44"/>
  <xacro:property name="caster_y" value="0.27"/>

  <!-- 1. 시뮬레이션 플러그인 & 센서 기능 -->
  <xacro:include filename="$(find orange_description)/xacro/orange_robot_simulation.gazebo"/>
  <xacro:include filename="$(find orange_description)/xacro/sensors/hokuyo.xacro"/>
  <xacro:include filename="$(find orange_description)/xacro/sensors/livox_simulation.xacro"/>
  <xacro:include filename="$(find orange_description)/xacro/sensors/imu.xacro"/>

  <!-- 색상 물감 준비 -->
  <material name="yellow"><color rgba="0.9 0.8 0.0 1.0"/></material>
  <material name="grey"><color rgba="0.5 0.5 0.5 1.0"/></material>
  <material name="black"><color rgba="0.1 0.1 0.1 1.0"/></material>
  <material name="silver"><color rgba="0.8 0.8 0.8 1.0"/></material>
  <material name="red"><color rgba="0.8 0.1 0.1 1.0"/></material>

  <!-- 2. 가제보 중심점 (Base Footprint) -->
  <link name="base_footprint"/>
  <joint name="base_joint" type="fixed">
    <parent link="base_footprint"/>
    <child link="base_link"/>
    <origin xyz="0.0 0.0 0.1" rpy="0 0 0"/>
  </joint>

  <!-- 3. 노란색 본체 -->
  <link name="base_link">
    <visual>
      <origin xyz="0 0 0.15" rpy="0 0 0"/>
      <geometry><box size="${base_length} ${base_width} 0.3"/></geometry>
      <material name="yellow"/>
    </visual>
    <collision>
      <origin xyz="0 0 0.15" rpy="0 0 0"/>
      <geometry><box size="${base_length} ${base_width} 0.3"/></geometry>
    </collision>
    <inertial>
      <mass value="27.1"/>
      <origin xyz="0 0 0.15" rpy="0 0 0"/>
      <!-- Uniform-box approximation for the 1.00 x 0.70 x 0.30 m baseline body. -->
      <inertia ixx="1.3098" ixy="0.0" ixz="0.0" iyy="2.4616" iyz="0.0" izz="3.3649"/>
    </inertial>
  </link>

  <!-- IMU 센서 -->
  <xacro:sensor_imu name="imu" parent="base_link" size="0.05 0.05 0.05">
    <origin xyz="0 0 0.15" rpy="0 0 0"/>
  </xacro:sensor_imu>

  <!-- 4. 회색 지붕 -->
  <joint name="cover_joint" type="fixed">
    <parent link="base_link"/><child link="top_cover"/>
    <origin xyz="0 0 0.31" rpy="0 0 0"/>
  </joint>
  <link name="top_cover">
    <visual>
      <geometry><box size="${base_length} ${base_width} 0.02"/></geometry>
      <material name="grey"/>
    </visual>
  </link>

  <!-- 5. 은색 기둥 두 개 (앞뒤 높이 스위치 완료!) -->
  <joint name="front_mast_joint" type="fixed">
    <parent link="base_link"/><child link="front_mast_link"/>
    <origin xyz="0.3 0 0.72" rpy="0 0 0"/>
  </joint>
  <link name="front_mast_link">
    <visual><geometry><cylinder radius="0.02" length="0.8"/></geometry><material name="silver"/></visual>
  </link>

  <joint name="rear_mast_joint" type="fixed">
    <parent link="base_link"/><child link="rear_mast_link"/>
    <origin xyz="-0.3 0 0.57" rpy="0 0 0"/>
  </joint>
  <link name="rear_mast_link">
    <visual><geometry><cylinder radius="0.02" length="0.5"/></geometry><material name="silver"/></visual>
  </link>

  <!-- 6. 센서 (위치 스위치 완료!) -->
  <joint name="front_camera_joint" type="fixed">
    <parent link="front_mast_link"/><child link="front_camera"/>
    <origin xyz="0 0 0.42" rpy="0 0 0"/>
  </joint>
  <link name="front_camera">
    <visual><geometry><box size="0.05 0.05 0.05"/></geometry><material name="red"/></visual>
  </link>
  <xacro:mid360 name="livox" parent="front_camera" topic="mid360">
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </xacro:mid360>

  <joint name="rear_sensor_joint" type="fixed">
    <parent link="rear_mast_link"/><child link="rear_sensor"/>
    <origin xyz="0 0 0.27" rpy="0 0 0"/>
  </joint>
  <link name="rear_sensor">
    <visual><geometry><box size="0.1 0.1 0.1"/></geometry><material name="yellow"/></visual>
  </link>
  <xacro:sensor_hokuyo name="hokuyo" parent="rear_sensor" min_angle="-1.22" max_angle="1.22" samples="720">
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </xacro:sensor_hokuyo>

  <!-- 7. 메인 구동 바퀴 -->
  <joint name="left_wheel_hinge" type="continuous">
    <parent link="base_link"/><child link="left_wheel"/>
    <origin xyz="0 ${wheel_separation / 2.0} 0" rpy="-1.5707 0 0"/>
    <axis xyz="0 0 1"/>
    <limit effort="100" velocity="100.0"/>
  </joint>
  <link name="left_wheel">
    <visual><geometry><cylinder radius="${wheel_radius}" length="0.05"/></geometry><material name="black"/></visual>
    <collision><geometry><cylinder radius="${wheel_radius}" length="0.05"/></geometry></collision>
    <inertial><mass value="3.4"/><origin xyz="0 0 0"/><inertia ixx="0.009" ixy="0.0" ixz="0.0" iyy="0.009" iyz="0.0" izz="0.017"/></inertial>
  </link>

  <joint name="right_wheel_hinge" type="continuous">
    <parent link="base_link"/><child link="right_wheel"/>
    <origin xyz="0 ${-wheel_separation / 2.0} 0" rpy="-1.5707 0 0"/>
    <axis xyz="0 0 1"/>
    <limit effort="100" velocity="100.0"/>
  </joint>
  <link name="right_wheel">
    <visual><geometry><cylinder radius="${wheel_radius}" length="0.05"/></geometry><material name="black"/></visual>
    <collision><geometry><cylinder radius="${wheel_radius}" length="0.05"/></geometry></collision>
    <inertial><mass value="3.4"/><origin xyz="0 0 0"/><inertia ixx="0.009" ixy="0.0" ixz="0.0" iyy="0.009" iyz="0.0" izz="0.017"/></inertial>
  </link>

  <!-- 8. 보조 바퀴 (캐스터 4개) -->
  <joint name="fl_caster_joint" type="fixed"><parent link="base_link"/><child link="fl_caster"/><origin xyz="${caster_x} ${caster_y} -0.05" rpy="0 0 0"/></joint>
  <link name="fl_caster"><visual><geometry><sphere radius="0.05"/></geometry><material name="black"/></visual><collision><geometry><sphere radius="0.05"/></geometry></collision></link>
  <joint name="fr_caster_joint" type="fixed"><parent link="base_link"/><child link="fr_caster"/><origin xyz="${caster_x} ${-caster_y} -0.05" rpy="0 0 0"/></joint>
  <link name="fr_caster"><visual><geometry><sphere radius="0.05"/></geometry><material name="black"/></visual><collision><geometry><sphere radius="0.05"/></geometry></collision></link>
  <joint name="rl_caster_joint" type="fixed"><parent link="base_link"/><child link="rl_caster"/><origin xyz="${-caster_x} ${caster_y} -0.05" rpy="0 0 0"/></joint>
  <link name="rl_caster"><visual><geometry><sphere radius="0.05"/></geometry><material name="black"/></visual><collision><geometry><sphere radius="0.05"/></geometry></collision></link>
  <joint name="rr_caster_joint" type="fixed"><parent link="base_link"/><child link="rr_caster"/><origin xyz="${-caster_x} ${-caster_y} -0.05" rpy="0 0 0"/></joint>
  <link name="rr_caster"><visual><geometry><sphere radius="0.05"/></geometry><material name="black"/></visual><collision><geometry><sphere radius="0.05"/></geometry></collision></link>

</robot>